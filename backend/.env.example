DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require&channel_binding=require
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=your-api-domain.example
# Render Free: use Resend HTTPS delivery. Set this in Render, not in Git.
# Leaving RESEND_API_KEY empty retains the existing SMTP backend.
RESEND_API_KEY=
# For testing: DEFAULT_FROM_EMAIL=Urgoo <onboarding@resend.dev>
# The test sender can only deliver to the Resend account owner's email.
# For other recipients, use a sender address on your verified Resend domain.
# SMTP credentials below are optional and unused when RESEND_API_KEY is set.
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=replace-with-a-new-app-password
DEFAULT_FROM_EMAIL=your-email@example.com
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CORS_ALLOWED_ORIGINS=https://your-flutter-web-domain.example
CSRF_TRUSTED_ORIGINS=https://your-flutter-web-domain.example
